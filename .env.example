COMPOSE_PROJECT_NAME=smart-credit

POSTGRES_PORT=5432
POSTGRES_SUPERUSER_PASSWORD=postgres_local
AUTH_DB_PASSWORD=auth_local
CLIENT_DB_PASSWORD=client_local
BANK_DB_PASSWORD=bank_local

# bank-service
BANK_HTTP_ADDR=:8080
BANK_HTTP_READ_HEADER_TIMEOUT=5s
BANK_HTTP_READ_TIMEOUT=30s
BANK_HTTP_WRITE_TIMEOUT=30s
BANK_HTTP_IDLE_TIMEOUT=60s
BANK_HTTP_MAX_HEADER_BYTES=1048576
BANK_DATABASE_URL=postgres://bank_user:bank_local@127.0.0.1:5432/bank_db?sslmode=disable
BANK_SCORING_GRPC_ADDR=127.0.0.1:50051
BANK_BUREAU_GRPC_ADDR=127.0.0.1:50053
BANK_DB_CONNECT_TIMEOUT=5s
BANK_DB_MAX_CONNS=10
BANK_DB_MIN_CONNS=1
BANK_DB_MAX_CONN_LIFETIME=30m
BANK_DB_MAX_CONN_IDLE_TIME=5m
BANK_DB_HEALTH_CHECK_PERIOD=1m
BANK_READINESS_TIMEOUT=1s
BANK_SHUTDOWN_TIMEOUT=10s

# Только для локальной проверки bank-service без auth middleware.
BANK_DEMO_ANALYST_ID=

# client-service
CLIENT_HTTP_ADDR=:8083
CLIENT_HTTP_READ_HEADER_TIMEOUT=5s
CLIENT_HTTP_READ_TIMEOUT=30s
CLIENT_HTTP_WRITE_TIMEOUT=30s
CLIENT_HTTP_IDLE_TIMEOUT=60s
CLIENT_HTTP_MAX_HEADER_BYTES=1048576
CLIENT_DATABASE_URL=postgres://client_user:client_local@127.0.0.1:5432/client_db?sslmode=disable
CLIENT_DB_CONNECT_TIMEOUT=5s
CLIENT_DB_MAX_CONNS=10
CLIENT_DB_MIN_CONNS=1
CLIENT_DB_MAX_CONN_LIFETIME=30m
CLIENT_DB_MAX_CONN_IDLE_TIME=5m
CLIENT_DB_HEALTH_CHECK_PERIOD=1m
CLIENT_READINESS_TIMEOUT=1s
CLIENT_SHUTDOWN_TIMEOUT=10s

KAFKA_PORT=9092
SWAGGER_PORT=8081
GATEWAY_PORT=8000

# Scoring gRPC port on localhost
SCORING_PORT=50051
ASSISTANT_PORT=50052
BUREAU_PORT=50053
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_URL=http://host.docker.internal:11434
