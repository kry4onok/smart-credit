COMPOSE_PROJECT_NAME=smart-credit

POSTGRES_PORT=5432
POSTGRES_SUPERUSER_PASSWORD=postgres_local
AUTH_DB_PASSWORD=auth_local
CLIENT_DB_PASSWORD=client_local
BANK_DB_PASSWORD=bank_local

# auth
AUTH_HTTP_ADDR=:8082
AUTH_HTTP_READ_HEADER_TIMEOUT=5s
AUTH_HTTP_READ_TIMEOUT=30s
AUTH_HTTP_WRITE_TIMEOUT=30s
AUTH_HTTP_IDLE_TIMEOUT=60s
AUTH_HTTP_MAX_HEADER_BYTES=1048576
AUTH_DATABASE_URL=postgres://auth_user:auth_local@127.0.0.1:5432/auth_db?sslmode=disable
AUTH_DB_CONNECT_TIMEOUT=5s
AUTH_DB_MAX_CONNS=10
AUTH_DB_MIN_CONNS=1
AUTH_DB_MAX_CONN_LIFETIME=30m
AUTH_DB_MAX_CONN_IDLE_TIME=5m
AUTH_DB_HEALTH_CHECK_PERIOD=1m
AUTH_READINESS_TIMEOUT=1s
AUTH_SHUTDOWN_TIMEOUT=10s
AUTH_JWT_ISSUER=smart-credit-auth
AUTH_JWT_AUDIENCE=smart-credit
AUTH_JWT_ACCESS_TTL=15m
AUTH_JWT_KEY_ID=auth-v1
# Создать один раз: go run ./services/auth/cmd/keygen -out .data/auth/private.pem
AUTH_JWT_PRIVATE_KEY_PATH=.data/auth/private.pem
AUTH_REFRESH_COOKIE_NAME=smart_credit_refresh
AUTH_REFRESH_COOKIE_PATH=/api/auth
AUTH_REFRESH_COOKIE_SECURE=false

# Только локальный auth dev seed; задайте пароли в игнорируемом Git файле .env.
AUTH_DEV_ANALYST_PASSWORD=
AUTH_DEV_ADMIN_PASSWORD=
AUTH_DEV_CLIENT_PASSWORD=

# bank-service
BANK_HTTP_ADDR=:8080
BANK_HTTP_READ_HEADER_TIMEOUT=5s
BANK_HTTP_READ_TIMEOUT=30s
BANK_HTTP_WRITE_TIMEOUT=30s
BANK_HTTP_IDLE_TIMEOUT=60s
BANK_HTTP_MAX_HEADER_BYTES=1048576
BANK_DATABASE_URL=postgres://bank_user:bank_local@127.0.0.1:5432/bank_db?sslmode=disable
BANK_SCORING_GRPC_ADDR=127.0.0.1:50051
BANK_BUREAU_GRPC_ADDR=127.0.0.1:50053
BANK_ASSISTANT_GRPC_ADDR=127.0.0.1:50052
BANK_ASSISTANT_TIMEOUT=5s
BANK_KAFKA_BROKERS=127.0.0.1:9092
BANK_KAFKA_CONSUMER_GROUP=bank-service
BANK_DB_CONNECT_TIMEOUT=5s
BANK_DB_MAX_CONNS=10
BANK_DB_MIN_CONNS=1
BANK_DB_MAX_CONN_LIFETIME=30m
BANK_DB_MAX_CONN_IDLE_TIME=5m
BANK_DB_HEALTH_CHECK_PERIOD=1m
BANK_READINESS_TIMEOUT=1s
BANK_SHUTDOWN_TIMEOUT=10s

# Bank API проверяет access JWT через публичный JWKS auth.
BANK_JWKS_URL=http://127.0.0.1:8082/.well-known/jwks.json
BANK_JWT_ISSUER=smart-credit-auth
BANK_JWT_AUDIENCE=smart-credit
BANK_JWKS_TIMEOUT=2s
BANK_JWKS_CACHE_TTL=5m

# client-service
CLIENT_JWKS_URL=http://127.0.0.1:8082/.well-known/jwks.json
CLIENT_JWT_ISSUER=smart-credit-auth
CLIENT_JWT_AUDIENCE=smart-credit
CLIENT_JWKS_TIMEOUT=2s
CLIENT_JWKS_CACHE_TTL=5m
CLIENT_HTTP_ADDR=:8083
CLIENT_HTTP_READ_HEADER_TIMEOUT=5s
CLIENT_HTTP_READ_TIMEOUT=30s
CLIENT_HTTP_WRITE_TIMEOUT=30s
CLIENT_HTTP_IDLE_TIMEOUT=60s
CLIENT_HTTP_MAX_HEADER_BYTES=1048576
CLIENT_DATABASE_URL=postgres://client_user:client_local@127.0.0.1:5432/client_db?sslmode=disable
CLIENT_DOCUMENT_STORAGE_PATH=.data/client-documents
CLIENT_KAFKA_BROKERS=127.0.0.1:9092
CLIENT_KAFKA_CONSUMER_GROUP=client-service
CLIENT_DB_CONNECT_TIMEOUT=5s
CLIENT_DB_MAX_CONNS=10
CLIENT_DB_MIN_CONNS=1
CLIENT_DB_MAX_CONN_LIFETIME=30m
CLIENT_DB_MAX_CONN_IDLE_TIME=5m
CLIENT_DB_HEALTH_CHECK_PERIOD=1m
CLIENT_READINESS_TIMEOUT=1s
CLIENT_SHUTDOWN_TIMEOUT=10s

KAFKA_PORT=9092
SWAGGER_PORT=8081
GATEWAY_PORT=8000
WEB_PORT=3000

# Scoring gRPC port on localhost
SCORING_PORT=50051
ASSISTANT_PORT=50052
BUREAU_PORT=50053
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_URL=http://host.docker.internal:11434
# Необязательные настройки ML-2. Пустые LLM_BASE_URL/LLM_MODEL берутся из OLLAMA_URL/OLLAMA_MODEL.
# Для OpenAI-совместимого сервера: LLM_PROVIDER=openai, LLM_BASE_URL=https://host/v1.
LLM_PROVIDER=ollama
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
