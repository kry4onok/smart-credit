  "item": [
    {
      "name": "01 Login client",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{client_email}}\",\n  \"password\": \"{{client_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.unset('application_id');",
              "pm.environment.unset('offer_id');",
              "pm.environment.unset('poll_attempt');",
              "pm.environment.unset('result_poll_attempt');",
              "pm.environment.unset('disbursement_poll_attempt');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Client login: 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  pm.environment.set('client_token', pm.response.json().access_token);",
              "} else {",
              "  pm.execution.setNextRequest(null);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Check company",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/client/company",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{client_token}}",
              "type": "string"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Company exists or needs creation', () => pm.expect([200, 404]).to.include(pm.response.code));",
              "if (pm.response.code === 200) {",
              "  pm.execution.setNextRequest('04 List products');",
              "} else if (pm.response.code !== 404) {",
              "  pm.execution.setNextRequest(null);",
              "}"
            ]
          }
        }
      ]
    },
