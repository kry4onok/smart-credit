{
  "info": {
    "_postman_id": "a9f7afcd-9280-44b4-8ee0-4c092203aaeb",
    "name": "Smart Credit — signing and disbursement E2E",
    "description": "Creates a fresh application, accepts its offer, signs the contract and waits for simulated disbursement.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
