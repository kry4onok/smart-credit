    {
      "name": "10 Wait for offer",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/client/applications/{{application_id}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{client_token}}",
              "type": "string"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Application readable: 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) {",
              "  pm.execution.setNextRequest(null);",
              "} else {",
              "  const data = pm.response.json();",
              "  const attempt = Number(pm.environment.get('poll_attempt') || 0) + 1;",
              "  pm.environment.set('poll_attempt', String(attempt));",
              "  if (data.status === 'OFFER_AVAILABLE' && data.offer && data.offer.offer_id) {",
              "    pm.environment.set('offer_id', data.offer.offer_id);",
              "    pm.test('Bank published an offer', () => pm.expect(data.offer.offer_id).to.match(/^[0-9a-f-]{36}$/i));",
              "  } else if (['CLOSED', 'REJECTED', 'NEEDS_INFO'].includes(data.status)) {",
              "    pm.test('Expected automatic offer; received ' + data.status, () => pm.expect(data.status).to.eql('OFFER_AVAILABLE'));",
              "    pm.execution.setNextRequest(null);",
              "  } else if (attempt < 60) {",
              "    pm.execution.setNextRequest(pm.info.requestId);",
              "  } else {",
              "    pm.test('Offer published within 60 polls', () => pm.expect(data.status).to.eql('OFFER_AVAILABLE'));",
              "    pm.execution.setNextRequest(null);",
              "  }",
              "}"
            ]
          }
        }
      ]
    },
