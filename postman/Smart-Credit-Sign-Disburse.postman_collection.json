              "if (pm.response.code === 202) {",
              "  pm.test('Pending action is ACCEPT_PENDING', () => pm.expect(pm.response.json().pending_action).to.eql('ACCEPT_PENDING'));",
              "} else {",
              "  pm.execution.setNextRequest(null);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Wait for FORMALIZING",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/client/applications/{{application_id}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{client_token}}",
              "type": "string"
            }
