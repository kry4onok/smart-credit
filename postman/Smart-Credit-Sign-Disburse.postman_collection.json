          "raw": "{\n  \"inn\": \"7707083893\",\n  \"name\": \"ООО «Северная пекарня»\",\n  \"okved\": \"10.71\",\n  \"registered_at\": \"2019-04-15\",\n  \"revenue_12m\": {\n    \"amount_kopecks\": 840000000,\n    \"currency\": \"RUB\"\n  },\n  \"profit_12m\": {\n    \"amount_kopecks\": 96000000,\n    \"currency\": \"RUB\"\n  },\n  \"obligations\": {\n    \"amount_kopecks\": 120000000,\n    \"currency\": \"RUB\"\n  }\n}",
