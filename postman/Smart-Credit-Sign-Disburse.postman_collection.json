              "pm.test('Bank audit: 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const actions = (pm.response.json().items || []).map(item => item.action);",
              "  pm.test('Signing and demo disbursement audited', () => {",
              "    pm.expect(actions).to.include('CONTRACT_SIGNED');",
              "    pm.expect(actions).to.include('DEMO_DISBURSED');",
              "  });",
              "}"
            ]
          }
        }
      ]
    }
  ]
}
