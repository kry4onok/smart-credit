        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Application readable: 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) {",
              "  pm.execution.setNextRequest(null);",
              "} else {",
              "  const data = pm.response.json();",
              "  const attempt = Number(pm.environment.get('result_poll_attempt') || 0) + 1;",
              "  pm.environment.set('result_poll_attempt', String(attempt));",
              "  if (data.status === 'FORMALIZING') {",
              "    pm.test('Bank confirmed FORMALIZING', () => {",
              "      pm.expect(data.pending_action).to.be.oneOf([undefined, null]);",
              "      pm.expect(data.status).to.eql('FORMALIZING');",
              "    });",
              "  } else if (attempt < 60) {",
              "    pm.execution.setNextRequest(pm.info.requestId);",
              "  } else {",
              "    pm.test('Expected FORMALIZING within 60 polls', () => pm.expect(data.status).to.eql('FORMALIZING'));",
              "    pm.execution.setNextRequest(null);",
              "  }",
              "}"
            ]
          }
        }
      ]
    },
