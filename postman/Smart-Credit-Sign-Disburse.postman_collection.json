    {
      "name": "04 List products",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/client/products",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{client_token}}",
              "type": "string"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Products: 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  const product = (data.items || []).find(item => item.code === 'WORKING');",
              "  pm.test('WORKING in published catalog', () => {",
              "    pm.expect(data.catalog_version).to.be.above(0);",
              "    pm.expect(product).to.exist;",
              "  });",
              "  if (product) pm.environment.set('product_id', product.id);",
              "  else pm.execution.setNextRequest(null);",
              "} else {",
              "  pm.execution.setNextRequest(null);",
              "}"
            ]
          }
        }
      ]
    },
