    {
      "name": "06 Read draft and ETag",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/client/applications/{{application_id}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{client_token}}",
              "type": "string"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Draft: 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.environment.set('application_etag', pm.response.headers.get('ETag'));",
              "  pm.test('Draft has ETag', () => {",
              "    pm.expect(data.status).to.eql('DRAFT');",
              "    pm.expect(pm.environment.get('application_etag')).to.match(/^\"[1-9][0-9]*\"$/);",
              "  });",
              "} else {",
              "  pm.execution.setNextRequest(null);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Fill application form",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/merge-patch+json"
          },
          {
            "key": "If-Match",
            "value": "{{application_etag}}"
          }
        ],
        "url": "{{base_url}}/api/client/applications/{{application_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": {\n    \"amount_kopecks\": 300000000,\n    \"currency\": \"RUB\"\n  },\n  \"term_months\": 18,\n  \"purpose\": \"WORKING_CAPITAL\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{client_token}}",
              "type": "string"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Form updated: 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.test('Valid amount and term', () => {",
              "    pm.expect(data.form.amount.amount_kopecks).to.eql(300000000);",
              "    pm.expect(data.form.term_months).to.eql(18);",
              "  });",
              "} else {",
              "  pm.execution.setNextRequest(null);",
              "}"
            ]
          }
        }
      ]
