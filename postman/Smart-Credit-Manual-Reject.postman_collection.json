{
  "info": {
    "_postman_id": "c8208b30-3ce6-4977-8629-6df79a6789ea",
    "name": "Smart Credit — manual rejection E2E",
    "description": "Creates a fresh application above the automatic revenue ratio, takes the case as analyst and rejects it.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Login client",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{client_email}}\",\n  \"password\": \"{{client_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.unset('application_id');",
              "pm.environment.unset('bank_poll_attempt');",
              "pm.environment.unset('result_poll_attempt');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Client login: 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  pm.environment.set('client_token', pm.response.json().access_token);",
              "} else {",
              "  pm.execution.setNextRequest(null);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Check company",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/client/company",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{client_token}}",
              "type": "string"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Company exists or needs creation', () => pm.expect([200, 404]).to.include(pm.response.code));",
              "if (pm.response.code === 200) {",
              "  pm.execution.setNextRequest('04 List products');",
              "} else if (pm.response.code !== 404) {",
              "  pm.execution.setNextRequest(null);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Create company",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/client/company",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"inn\": \"7707083893\",\n  \"name\": \"ООО «Северная пекарня»\",\n  \"okved\": \"10.71\",\n  \"registered_at\": \"2019-04-15\",\n  \"revenue_12m\": {\n    \"amount_kopecks\": 840000000,\n    \"currency\": \"RUB\"\n  },\n  \"profit_12m\": {\n    \"amount_kopecks\": 96000000,\n    \"currency\": \"RUB\"\n  },\n  \"obligations\": {\n    \"amount_kopecks\": 120000000,\n    \"currency\": \"RUB\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{client_token}}",
              "type": "string"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Company created: 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) pm.execution.setNextRequest(null);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 List products",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/client/products",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{client_token}}",
              "type": "string"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Products: 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  const product = (data.items || []).find(item => item.code === 'WORKING');",
              "  pm.test('WORKING in published catalog', () => {",
              "    pm.expect(data.catalog_version).to.be.above(0);",
              "    pm.expect(product).to.exist;",
              "  });",
              "  if (product) pm.environment.set('product_id', product.id);",
              "  else pm.execution.setNextRequest(null);",
              "} else {",
              "  pm.execution.setNextRequest(null);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Create application",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": "{{base_url}}/api/client/applications",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product_id\": \"{{product_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{client_token}}",
              "type": "string"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Draft created: 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "  const data = pm.response.json();",
              "  pm.environment.set('application_id', data.id);",
              "  pm.test('Draft uses WORKING', () => pm.expect(data.product_id).to.eql(pm.environment.get('product_id')));",
              "} else {",
              "  pm.execution.setNextRequest(null);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Read draft and ETag",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/client/applications/{{application_id}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{client_token}}",
              "type": "string"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Draft: 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.environment.set('application_etag', pm.response.headers.get('ETag'));",
              "  pm.test('Draft has ETag', () => {",
              "    pm.expect(data.status).to.eql('DRAFT');",
              "    pm.expect(pm.environment.get('application_etag')).to.match(/^\"[1-9][0-9]*\"$/);",
              "  });",
              "} else {",
              "  pm.execution.setNextRequest(null);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Fill application form",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/merge-patch+json"
          },
          {
            "key": "If-Match",
            "value": "{{application_etag}}"
          }
        ],
        "url": "{{base_url}}/api/client/applications/{{application_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": {\n    \"amount_kopecks\": 500000000,\n    \"currency\": \"RUB\"\n  },\n  \"term_months\": 18,\n  \"purpose\": \"WORKING_CAPITAL\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{client_token}}",
              "type": "string"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Form updated: 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  pm.test('Amount exceeds the automatic offer revenue ratio', () => {",
              "    pm.expect(pm.response.json().form.amount.amount_kopecks).to.eql(500000000);",
              "  });",
              "} else {",
              "  pm.execution.setNextRequest(null);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Upload bank statement",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": "{{base_url}}/api/client/applications/{{application_id}}/documents",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "document_type",
              "value": "BANK_STATEMENT",
              "type": "text"
            },
            {
              "key": "file",
              "type": "file",
              "src": "fixtures/bank-statement.txt"
            }
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{client_token}}",
              "type": "string"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Statement uploaded: 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "  pm.test('Document type is BANK_STATEMENT', () => pm.expect(pm.response.json().document_type).to.eql('BANK_STATEMENT'));",
              "} else {",
              "  pm.execution.setNextRequest(null);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Submit application",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": "{{base_url}}/api/client/applications/{{application_id}}/submit",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{client_token}}",
              "type": "string"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Submitted: 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  pm.test('Client status SUBMITTED', () => pm.expect(pm.response.json().status).to.eql('SUBMITTED'));",
              "} else {",
              "  pm.execution.setNextRequest(null);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Login analyst",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{analyst_email}}\",\n  \"password\": \"{{analyst_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Analyst login: 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  pm.environment.set('analyst_token', pm.response.json().access_token);",
              "} else {",
              "  pm.execution.setNextRequest(null);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Wait for MANUAL_REVIEW",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/backoffice/applications/{{application_id}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{analyst_token}}",
              "type": "string"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 404) {",
              "  const attempt = Number(pm.environment.get('bank_poll_attempt') || 0) + 1;",
              "  pm.environment.set('bank_poll_attempt', String(attempt));",
              "  if (attempt < 60) pm.execution.setNextRequest(pm.info.requestId);",
              "  else pm.test('Bank case appeared within 60 polls', () => pm.expect(pm.response.code).to.eql(200));",
              "} else if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  const attempt = Number(pm.environment.get('bank_poll_attempt') || 0) + 1;",
              "  pm.environment.set('bank_poll_attempt', String(attempt));",
              "  if (data.status === 'MANUAL_REVIEW') {",
              "    pm.environment.set('bank_etag', pm.response.headers.get('ETag'));",
              "    pm.test('Manual review with ETag', () => pm.expect(pm.environment.get('bank_etag')).to.match(/^\"[1-9][0-9]*\"$/));",
              "  } else if (['REJECTED', 'OFFER', 'NEEDS_INFO'].includes(data.status) || attempt >= 60) {",
              "    pm.test('Expected MANUAL_REVIEW; received ' + data.status, () => pm.expect(data.status).to.eql('MANUAL_REVIEW'));",
              "    pm.execution.setNextRequest(null);",
              "  } else {",
              "    pm.execution.setNextRequest(pm.info.requestId);",
              "  }",
              "} else {",
              "  pm.test('Bank case readable: 200', () => pm.response.to.have.status(200));",
              "  pm.execution.setNextRequest(null);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Take case",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          },
          {
            "key": "If-Match",
            "value": "{{bank_etag}}"
          }
        ],
        "url": "{{base_url}}/api/backoffice/applications/{{application_id}}/take",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{analyst_token}}",
              "type": "string"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Case taken: 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  pm.environment.set('bank_etag', pm.response.headers.get('ETag'));",
              "  pm.test('Updated bank ETag', () => pm.expect(pm.environment.get('bank_etag')).to.match(/^\"[1-9][0-9]*\"$/));",
              "} else pm.execution.setNextRequest(null);"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Reject case",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          },
          {
            "key": "If-Match",
            "value": "{{bank_etag}}"
          }
        ],
        "url": "{{base_url}}/api/backoffice/applications/{{application_id}}/decision",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"outcome\": \"REJECT\",\n  \"comment\": \"Postman E2E: manual review\",\n  \"public_reason\": \"Заявка отклонена после проверки аналитиком.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{analyst_token}}",
              "type": "string"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Bank decision: 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  pm.test('Bank case REJECTED', () => pm.expect(pm.response.json().status).to.eql('REJECTED'));",
              "} else pm.execution.setNextRequest(null);"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Wait for REJECTED",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/client/applications/{{application_id}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{client_token}}",
              "type": "string"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Application readable: 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) {",
              "  pm.execution.setNextRequest(null);",
              "} else {",
              "  const data = pm.response.json();",
              "  const attempt = Number(pm.environment.get('result_poll_attempt') || 0) + 1;",
              "  pm.environment.set('result_poll_attempt', String(attempt));",
              "  if (data.status === 'REJECTED') {",
              "    pm.test('Bank confirmed REJECTED', () => {",
              "      pm.expect(data.pending_action).to.be.oneOf([undefined, null]);",
              "      pm.expect(data.status).to.eql('REJECTED');",
              "    });",
              "  } else if (attempt < 60) {",
              "    pm.execution.setNextRequest(pm.info.requestId);",
              "  } else {",
              "    pm.test('Expected REJECTED within 60 polls', () => pm.expect(data.status).to.eql('REJECTED'));",
              "    pm.execution.setNextRequest(null);",
              "  }",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "15 Check bank audit",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/backoffice/applications/{{application_id}}/audit",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{analyst_token}}",
              "type": "string"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Bank audit: 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const entries = pm.response.json().items || [];",
              "  pm.test('Analyst decision audited', () => pm.expect(entries.some(entry => entry.actor_type === 'ANALYST')).to.be.true);",
              "}"
            ]
          }
        }
      ]
    }
  ]
}
