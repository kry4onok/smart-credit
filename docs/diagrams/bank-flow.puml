@startuml
title Smart Credit — банковское дело и аналитик

skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam roundcorner 10
skinparam ArrowColor #526273
skinparam activity {
  BackgroundColor #FAFAFA
  BorderColor #526273
  FontColor #172234
  DiamondBackgroundColor #FFF2CC
  DiamondBorderColor #B38F00
}
skinparam partition {
  BackgroundColor #F4F6F8
  BorderColor #A9B4BF
  FontColor #33414F
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A45C
}

start
partition "1. Получение дела" {
  :ApplicationSubmitted из client.events; <<#DCEBFF>>
  :Дело в bank_db + processed_events; <<#E5F4E3>>
  if (Версия продукта известна?) then (нет)
    :MANUAL_REVIEW\nпричина UNKNOWN_PRODUCT; <<#FFF2CC>>
  else (да)
    :VALIDATION; <<#E5F4E3>>
    if (Данных достаточно?) then (нет)
      :NEEDS_INFO + запрос в bank.events; <<#FFF2CC>>
      :Ждать InfoProvided из client.events; <<#DCEBFF>>
      :VALIDATION — повторная проверка; <<#E5F4E3>>
    endif
    :ENRICHMENT — bureau-mocks gRPC; <<#E5F4E3>>
    :SCORING — scoring gRPC; <<#E5F4E3>>
    :DECISION — worker применяет правила; <<#E5F4E3>>
    note right
      DECISION — ожидание исхода правил,
      а не статус одобрения кредита.
    end note
  endif
}

partition "2. Оценка и решение аналитика" {
  if (Автоматический отказ?) then (да)
    :REJECTED + публичная причина\nв bank.events; <<#FFE6E6>>
    stop
  else (нет)
    if (Нужны сведения?) then (да)
      :NEEDS_INFO → ждать InfoProvided; <<#FFF2CC>>
      stop
    else (нужно подтверждение)
      :MANUAL_REVIEW; <<#FFF2CC>>
    endif
  endif
  :Аналитик: /bank → список\n→ карточка → /take; <<#DCEBFF>>
  if (Есть варианты SME_CASHFLOW_V2?) then (да)
    :Просмотр оценки и вариантов CALCULATED;\nвыбор актуального варианта; <<#DCEBFF>>
  endif
  :/decision с If-Match\nи Idempotency-Key; <<#DCEBFF>>
  note right
    APPROVE / COUNTER → оферта
    REQUEST_INFO → запрос сведений
    REJECT → отказ
    Автоматической оферты нет.
  end note
  if (Аналитик отказал?) then (да)
    :REJECTED → bank.events; <<#FFE6E6>>
    stop
  else (нет)
    if (Запрошены сведения?) then (да)
      :NEEDS_INFO → ждать InfoProvided; <<#FFF2CC>>
      stop
    else (подтверждена оферта)
      :OFFER / COUNTER_OFFER\n→ bank.events; <<#E5F4E3>>
    endif
  endif
}

partition "3. Оферта и завершение" {
  if (Клиент отказался или отозвал?) then (да)
    :CANCELLED → bank.events; <<#FFE6E6>>
    stop
  else (нет)
    if (Срок истёк?) then (да)
      :EXPIRED → bank.events; <<#FFE6E6>>
      stop
    else (принял)
      :OfferAccepted → сверка offer_id; <<#DCEBFF>>
      :OFFER_ACCEPTED → FORMALIZING; <<#E5F4E3>>
      :ContractSigned из client.events; <<#DCEBFF>>
      :SIGNING → worker → DISBURSED;\nвыдача только симулируется; <<#E5F4E3>>
    endif
  endif
}
stop

legend right
|= Цвет |= Значение |
|<#DCEBFF>| Событие клиента или действие аналитика |
|<#E5F4E3>| Банковская обработка и запись в bank_db |
|<#FFF2CC>| Ручной выбор или ожидание данных |
|<#FFE6E6>| Завершение без выдачи |
endlegend
@enduml
