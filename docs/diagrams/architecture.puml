@startuml architecture
!theme plain
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 18
skinparam defaultFontColor #17233B
skinparam ArrowColor #416791
skinparam ArrowThickness 2
skinparam roundCorner 16
skinparam componentStyle rectangle
skinparam componentBorderColor #B8CBE6
skinparam componentBackgroundColor #EDF4FF
skinparam queueBorderColor #C48A23
skinparam queueBackgroundColor #FFF2D9
hide stereotype
title Smart Credit — карта сервисов MVP

actor "Клиент" as customer
actor "Аналитик" as analyst

component "<b>Вход и доступ</b>\nweb · gateway / Swagger\nauth · auth_db" as entry #E8F0FF
component "<b>Клиентский контур</b>\nclient-service\nclient_db" as client #E8F0FF
queue "<b>Kafka</b>\nclient.events\nbank.events" as kafka #FFF2D9
component "<b>Банковский контур</b>\nbank-service\nbank_db" as bank #E8F0FF
component "<b>Локальные проверки</b>\nbureau-mocks\nscoring · assistant" as deps #E3F7F2

customer --> entry
analyst --> entry
entry --> client : HTTP API
client <--> kafka : события
kafka <--> bank : события
bank --> deps : gRPC

legend bottom
  <b>HTTP:</b> web и gateway маршрутизируют запросы к auth, client-service и bank-service.
  <b>БД:</b> auth_db, client_db и bank_db — отдельные базы в одном PostgreSQL.
  <b>Граница:</b> состояние client ↔ bank передаётся через Kafka; оригинал вложения банк читает по защищённому HTTP GET.
endlegend
@enduml
