@startuml architecture
!theme plain
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam componentStyle rectangle
skinparam componentBackgroundColor #EAF2FF
skinparam componentBorderColor #2055A2
skinparam databaseBackgroundColor #FFFFFF
skinparam queueBackgroundColor #FFF0EE
skinparam ArrowColor #506174
hide stereotype
title Smart Credit — сервисы и протоколы MVP

actor "Браузер" as browser
component "web / nginx" as web
component "gateway / nginx" as gateway
component "Swagger UI" as swagger
component "auth" as auth
component "client-service" as client
component "bank-service" as bank
queue "Kafka\nclient.events / bank.events" as kafka
database "auth_db" as authdb
database "client_db" as clientdb
database "bank_db" as bankdb
component "bureau-mocks" as bureau
component "scoring" as scoring
component "assistant" as assistant
component "Ollama (опция)" as ollama

browser --> web : HTTP
browser --> gateway : HTTP
web --> auth : HTTP /api/auth
web --> client : HTTP /api/client
web --> bank : HTTP /api/backoffice
gateway --> auth : HTTP /api/auth
gateway --> client : HTTP /api/client
gateway --> bank : HTTP /api/backoffice
gateway --> swagger : HTTP /docs
client --> auth : HTTP JWKS
bank --> auth : HTTP JWKS
auth --> authdb : PostgreSQL
client --> clientdb : PostgreSQL
bank --> bankdb : PostgreSQL
client --> kafka : Kafka client.events
kafka --> bank : Kafka client.events
bank --> kafka : Kafka bank.events
kafka --> client : Kafka bank.events
bank --> client : HTTP GET документа
bank --> bureau : gRPC
bank --> scoring : gRPC
bank --> assistant : gRPC
client --> assistant : gRPC Help
assistant --> ollama : HTTP (опция)

note bottom of kafka
  Изменения бизнес-состояния client ↔ bank идут через Kafka.
  Три БД разделены; оригиналы файлов и ключ auth — Docker volumes.
end note
@enduml
