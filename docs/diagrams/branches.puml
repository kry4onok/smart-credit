@startuml branches
skinparam backgroundColor #F8FAFC
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontColor #172033
skinparam sequenceArrowColor #2563EB
skinparam sequenceLifeLineBorderColor #CBD5E1
skinparam sequenceParticipantBorderColor #2563EB
skinparam sequenceParticipantBackgroundColor #EFF6FF
skinparam sequenceGroupBorderColor #94A3B8
skinparam sequenceGroupBackgroundColor #F1F5F9
title Smart Credit — альтернативы основному пути

actor "Клиент" as User
participant "client-service" as Client
queue "Kafka" as Kafka
participant "bank-service" as Bank
actor "Аналитик" as Analyst

alt Отказ от активной оферты
  User -> Client: POST /offer/decline
  Client -> Kafka: client.events: OfferDeclined
  Kafka -> Bank: Проверка offer_id
  Bank -> Kafka: bank.events: CLOSED (банк CANCELLED)
  Kafka -> Client: Публичный снимок
else Отзыв до подписи
  User -> Client: POST /cancel
  Client -> Kafka: client.events: ApplicationCancelled
  Kafka -> Bank: Проверка допустимости
  Bank -> Kafka: bank.events: CLOSED (банк CANCELLED)
  Kafka -> Client: Публичный снимок
else Истёк срок оферты
  Bank -> Bank: Worker истечения проверяет expires_at
  Bank -> Kafka: bank.events: CLOSED (банк EXPIRED)
  Kafka -> Client: Публичный снимок
else Ручное решение
  Bank -> Kafka: bank.events: UNDER_REVIEW (MANUAL_REVIEW)
  Kafka -> Client: Публичный снимок
  Analyst -> Bank: Take + decision
  note right of Bank: APPROVE / COUNTER → оферта\nREQUEST_INFO → запрос данных\nREJECT → отказ
  Bank -> Kafka: bank.events: новый публичный снимок
  Kafka -> Client: Оферта / NEEDS_INFO / REJECTED
end
@enduml
